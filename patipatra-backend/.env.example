# Copy this file to ".env" and fill it in. Lines starting with # are comments.

# ---- Server ----
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# Public address of THIS backend, no trailing slash. Used to build the customer's
# review link and the admin links. Example: https://patipatra.onrender.com
PUBLIC_BASE_URL=

# Set to true when running behind Render / Railway / Nginx / Cloudflare so the
# real visitor IP is used for spam limits.
TRUST_PROXY=true

# ---- Admin login (CHANGE THESE) ----
ADMIN_PASSWORD=change-this-password
# Any long random text. Keeps admin logins valid across restarts.
SESSION_SECRET=change-this-to-a-long-random-text

# ---- Where the React/Vite website lives (so it may call this API) ----
# Comma separated. Example: https://patipatra.netlify.app,https://www.patipatra.in
ALLOWED_ORIGINS=

# ---- Storage (use a persistent disk in production) ----
# DATA_DIR=./data
# UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=150

# ---- Instant phone alerts for new bookings (optional, free) ----
# Create a bot with @BotFather on Telegram, then send it one message and
# open https://api.telegram.org/bot<TOKEN>/getUpdates to find your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: any URL that should receive a JSON POST for every new booking/review
# (Zapier, Make, n8n, ...).
WEBHOOK_URL=

# ---- Sample content ----
# Adds sample gallery photos on first run so the gallery page is not empty.
# Delete them from the admin panel and add your own work.
SEED_DEMO_GALLERY=true
